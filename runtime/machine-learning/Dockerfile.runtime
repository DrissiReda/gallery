FROM ghcr.io/open-noodle/gallery-ml@sha256:f29d3737d4dc926d43de303cce3cd32d9f804e7ef7c595c8ea7dcbfa6caf666a
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN /opt/venv/bin/python -c 'import certifi, requests; assert certifi.__version__ == "2026.10.19"; assert requests.certs.where() == certifi.where()'
