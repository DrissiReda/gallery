FROM ghcr.io/open-noodle/gallery-ml@sha256:b728719989188489796ff02133f5495e0f64e766f6ac9da964a736522b707b3f
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && update-ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN /opt/venv/bin/python -c 'import certifi, requests; assert certifi.__version__ == "2026.10.19"; assert requests.certs.where() == certifi.where()'
